# systemd-Unit für den SecondBrainWiki-MCP-Server
#
# Standardwerte. install.sh ersetzt Wiki-Pfad, Dienstkonto und ProtectHome
# beim Installieren durch die tatsächlichen Werte; von Hand bitte anpassen:
#   Programm + venv:  /usr/local/llm-wiki  (server.py, config.json, .venv/)
#   Wiki-Repo:        /srv/claude-wiki     (= "wiki_dir" in config.json)
#   Dienstkonto:      llm-wiki             (Systembenutzer ohne Login)
#
# Installation: am einfachsten mit install.sh im Projektordner, sonst von Hand:
#   sudo cp llm-wiki.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now llm-wiki
#   journalctl -u llm-wiki -f

[Unit]
Description=SecondBrainWiki MCP-Server
Documentation=file:///usr/local/llm-wiki/README.md
After=network-online.target
Wants=network-online.target
# Liegt das Wiki auf einem Netzlaufwerk, den Mount hier eintragen, z. B.:
# RequiresMountsFor=/srv/claude-wiki

[Service]
Type=simple
User=llm-wiki
Group=llm-wiki
WorkingDirectory=/usr/local/llm-wiki
ExecStart=/usr/local/llm-wiki/.venv/bin/python /usr/local/llm-wiki/server.py

# Ausgaben sofort ins Journal schreiben
Environment=PYTHONUNBUFFERED=1
# git braucht ein HOME und eine Identität für Commits
Environment=HOME=/var/lib/llm-wiki
Environment="GIT_AUTHOR_NAME=SecondBrainWiki MCP"
Environment=GIT_AUTHOR_EMAIL=llm-wiki@localhost
Environment="GIT_COMMITTER_NAME=SecondBrainWiki MCP"
Environment=GIT_COMMITTER_EMAIL=llm-wiki@localhost

Restart=on-failure
RestartSec=5

# --- Härtung ---------------------------------------------------------------
# Dateisystem schreibgeschützt bis auf das Wiki und das State-Verzeichnis.
# Hinweis: config.json muss vorhanden sein – der Dienst kann sie unter
# /usr/local/llm-wiki nicht selbst anlegen.
ProtectSystem=strict
ReadWritePaths=/srv/claude-wiki
StateDirectory=llm-wiki
# Zugriffsprotokoll von read_raw_file/list_raw_files: /var/log/wiki-mcp/raw-access.log
# (systemd legt den Ordner an und gibt ihn dem Dienstkonto, trotz ProtectSystem=strict)
LogsDirectory=wiki-mcp
LogsDirectoryMode=0750
# raw/ enthält Symlinks auf die Quellordner (z. B. Nextcloud-Daten). Deren Ziele
# müssen für das Dienstkonto lesbar sein; ProtectSystem=strict erlaubt Lesen.
# Liegen sie unter /home, darf ProtectHome nicht true sein (install.sh prüft das).
# Die Sperrliste /etc/wiki-mcp/raw-denylist.txt ist nur lesbar.
# true blendet /home, /root und /run/user komplett aus. Liegt das Wiki dort
# (z. B. /home/claude/llm-wiki), auf read-only setzen – ReadWritePaths gibt den
# Wiki-Ordner trotzdem zum Schreiben frei. install.sh macht das automatisch.
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
